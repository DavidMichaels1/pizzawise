    "bcryptjs": "^3.0.3",
    "fastify": "^5.1.0",
    "fastify-plugin": "^5.0.1",
    "prisma": "^6.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "pino-pretty": "^13.0.0",
    "typescript": "^5.7.2",
    "vitest": "^5.0.2"
  }
